[Unit]
Description=Shelllist clipboard capture and policy service
Documentation=https://github.com/pmfleming/clip-daemon
After=graphical-session-pre.target ringboard-server.service ringboard-wayland.service
PartOf=graphical-session.target
Wants=ringboard-server.service
# Stop the retired managed collector before opening in-process admission.
Conflicts=ringboard-wayland.service

[Service]
Type=dbus
BusName=org.laufan.ClipDaemon
ExecStart=@out@/bin/clip-daemon daemon
UMask=0077
TimeoutStopSec=30s
StateDirectory=clip-daemon
StateDirectoryMode=0700
CacheDirectory=clip-daemon
CacheDirectoryMode=0700
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
