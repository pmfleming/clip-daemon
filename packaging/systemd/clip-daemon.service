[Unit]
Description=Shelllist clipboard capture, Turso history and policy service
Documentation=https://github.com/pmfleming/clip-daemon
After=graphical-session-pre.target ringboard-server.service ringboard-wayland.service
PartOf=graphical-session.target
# Stop retired services before the single storage/capture owner starts.
Conflicts=ringboard-server.service ringboard-wayland.service

[Service]
Type=dbus
BusName=org.laufan.ClipDaemon
ExecStart=@out@/bin/clip-daemon daemon
UMask=0077
TimeoutStopSec=30s
StateDirectory=clip-daemon
StateDirectoryMode=0700
CacheDirectory=clip-daemon
CacheDirectoryMode=0700
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=graphical-session.target
